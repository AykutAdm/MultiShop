@model List<ResultBrandDto>

<div class="container-fluid px-xl-5 ms-section">
    <div class="ms-head ms-reveal">
        <div>
            <span class="ms-kicker">İş Ortaklarımız</span>
            <h2 class="ms-title">Anlaşmalı Markalar</h2>
        </div>
    </div>

    <div class="ms-brands ms-reveal">
        <div class="owl-carousel vendor-carousel">

            @foreach (var item in Model)
            {
                <div class="ms-brand">
                    <img src="@item.ImageUrl" alt="@item.BrandName">
                </div>
            }

        </div>
    </div>
</div>
