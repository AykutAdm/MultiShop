@model List<ResultOfferDiscountDto>

<div class="container-fluid px-xl-5 ms-section">
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <a href="" class="ms-promo ms-promo--wide ms-reveal">
                    <img src="@item.ImageUrl" alt="@item.Title">
                    <span class="ms-promo-veil"></span>
                    <span class="ms-promo-body">
                        <span class="ms-promo-kicker">@item.Title</span>
                        <span class="ms-promo-title">@item.SubTitle</span>
                        <span class="ms-promo-cta">@item.ButtonTitle <i class="fa fa-arrow-right"></i></span>
                    </span>
                </a>
            </div>
        }

    </div>
</div>
