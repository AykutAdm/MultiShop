@model List<BasketItemDto>

<div class="col-lg-8 mb-5">
    <div class="ms-cart">
        <div class="ms-cart-head">
            <span>Ürün</span>
            <span>Fiyat</span>
            <span>Miktar</span>
            <span>Toplam</span>
            <span>Kaldır</span>
        </div>

        @foreach (var item in Model)
        {
            decimal satirToplami = item.Price * item.Quantity;

            <div class="ms-cart-row">
                <div class="ms-cart-product">
                    <span class="ms-cart-thumb">
                        <img src="@item.ProductImageUrl" alt="@item.ProductName">
                    </span>
                    <span class="ms-cart-name">@item.ProductName</span>
                </div>
                <div class="ms-cart-cell" data-label="Fiyat">
                    <span class="ms-cart-price">@item.Price ₺</span>
                </div>
                <div class="ms-cart-cell" data-label="Miktar">
                    <div class="input-group quantity ms-qty">
                        <div class="input-group-btn">
                            <button class="btn btn-minus" type="button"><i class="fa fa-minus"></i></button>
                        </div>
                        <input type="text" class="form-control text-center" value="@item.Quantity">
                        <div class="input-group-btn">
                            <button class="btn btn-plus" type="button"><i class="fa fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                <div class="ms-cart-cell" data-label="Toplam">
                    <span class="ms-cart-total">@satirToplami ₺</span>
                </div>
                <div class="ms-cart-cell" data-label="Kaldır">
                    <a href="/ShoppingCart/RemoveBasketItem/@item.ProductId" class="ms-cart-remove" title="Ürünü kaldır">
                        <i class="fa fa-times"></i>
                    </a>
                </div>
            </div>
        }

    </div>
</div>
