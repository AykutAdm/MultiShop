@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model List<ResultCategoryDto>

<div class="ms-navbar">
    <div class="container-fluid px-xl-5">
        <div class="row">
            <div class="col-lg-3 d-none d-lg-block ms-nav-cats">
                <a class="ms-cats-toggle" data-toggle="collapse" href="#navbar-vertical" aria-expanded="false">
                    <span class="ms-cats-label"><i class="fa fa-bars"></i>Kategoriler</span>
                    <i class="fa fa-angle-down ms-caret"></i>
                </a>
                <nav class="collapse ms-cats-menu" id="navbar-vertical">
                    @foreach (var item in Model)
                    {
                        <a href="/ProductList/Index/@item.CategoryId" class="ms-cat-link">
                            <span>@item.CategoryName</span>
                            <i class="fa fa-angle-right"></i>
                        </a>
                    }
                </nav>
            </div>
            <div class="col-lg-9">
                <nav class="navbar navbar-expand-lg navbar-dark ms-mainnav py-3 py-lg-0 px-0">
                    <a href="" class="ms-logo ms-logo--sm d-lg-none">
                        <span class="ms-logo-word"><span class="ms-logo-a">Multi</span>Shop<span class="ms-logo-dot"></span></span>
                    </a>
                    <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
                        <div class="navbar-nav mr-auto py-0">
                            <a href="/Default/Index/" class="nav-item nav-link">@localizer["Ana Sayfa"]</a>
                            <a href="shop.html" class="nav-item nav-link">@localizer["Ürünler"]</a>
                            <a href="detail.html" class="nav-item nav-link">@localizer["Ürün Detayları"]</a>
                            <a href="detail.html" class="nav-item nav-link">@localizer["Günün Fırsatı"]</a>
                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Sayfalar <i class="fa fa-angle-down ml-1"></i></a>
                                <div class="dropdown-menu">
                                    <a href="cart.html" class="dropdown-item">Sepetim</a>
                                    <a href="checkout.html" class="dropdown-item">Ödeme</a>
                                    <a href="/Register/Index/" class="dropdown-item">Kayıt Ol</a>
                                    <a href="/Login/Index/" class="dropdown-item">Giriş Yap</a>
                                </div>
                            </div>
                            <a href="/Contact/Index/" class="nav-item nav-link">İletişim</a>
                        </div>
                        <div class="navbar-nav ml-auto py-0 d-none d-lg-flex align-items-center">
                            <a href="" class="ms-nav-action" title="Favorilerim">
                                <i class="far fa-heart"></i>
                                <span class="ms-count">0</span>
                            </a>
                            <a href="" class="ms-nav-action ml-3" title="Sepetim">
                                <i class="fas fa-shopping-bag"></i>
                                <span class="ms-count">0</span>
                            </a>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>
</div>
