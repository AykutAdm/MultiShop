@model List<ResultFeatureDto>

<div class="container-fluid px-xl-5 ms-section">
    <div class="ms-features ms-reveal">

        @foreach (var item in Model)
        {
            <div class="ms-feature">
                <span class="ms-feature-icon"><i class="@item.Icon"></i></span>
                <h5 class="ms-feature-title">@item.Title</h5>
            </div>
        }

    </div>
</div>
