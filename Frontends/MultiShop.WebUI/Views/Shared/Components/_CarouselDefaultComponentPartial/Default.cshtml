@model List<ResultFeatureSliderDto>

@{
    int count = 0;
}

<div class="container-fluid px-xl-5 ms-hero">
    <div class="row">
        <div class="col-lg-8">
            <div id="header-carousel" class="carousel slide carousel-fade ms-hero-main" data-ride="carousel">
                <ol class="carousel-indicators">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <li data-target="#header-carousel" data-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
                    }
                </ol>
                <div class="carousel-inner">

                    @foreach (var item in Model)
                    {
                        count++;
                        <div class="carousel-item ms-hero-slide @(count == 1 ? "active" : "")">
                            <img src="@item.ImageUrl" alt="@item.Title">
                            <span class="ms-hero-veil"></span>
                            <div class="ms-hero-body">
                                <span class="ms-hero-badge"><span></span>Yeni Sezon</span>
                                <h1 class="ms-hero-title">@item.Title</h1>
                                <p class="ms-hero-text">@item.Description</p>
                                <div class="ms-hero-actions">
                                    <a class="ms-btn ms-btn-gold" href="#">Alışverişe Başla <i class="fa fa-arrow-right"></i></a>
                                    <a class="ms-btn ms-btn-ghost" href="#">Kampanyaları Gör</a>
                                </div>
                            </div>
                        </div>
                    }

                </div>
                <a class="carousel-control-prev" href="#header-carousel" role="button" data-slide="prev">
                    <span class="ms-hero-arrow"><i class="fa fa-angle-left"></i></span>
                    <span class="sr-only">Önceki</span>
                </a>
                <a class="carousel-control-next" href="#header-carousel" role="button" data-slide="next">
                    <span class="ms-hero-arrow"><i class="fa fa-angle-right"></i></span>
                    <span class="sr-only">Sonraki</span>
                </a>
            </div>
        </div>
        @await Component.InvokeAsync("_SpecialOfferComponentPartial")
    </div>
</div>
