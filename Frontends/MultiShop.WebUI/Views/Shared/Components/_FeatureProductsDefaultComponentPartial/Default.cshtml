@model List<ResultProductDto>

<div class="container-fluid px-xl-5 ms-section">
    <div class="ms-head ms-reveal">
        <div>
            <span class="ms-kicker">Vitrin</span>
            <h2 class="ms-title">Öne Çıkan Ürünler</h2>
            <p class="ms-sub">Bu hafta en çok tercih edilen ürünleri sizin için bir araya getirdik.</p>
        </div>
        <a href="" class="ms-head-link">Tümünü gör <i class="fa fa-arrow-right"></i></a>
    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            decimal x = ((item.ProductPrice / 100) * 15) + item.ProductPrice;
            int indirim = x > 0 ? (int)Math.Round((1 - (item.ProductPrice / x)) * 100) : 0;

            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="ms-product ms-reveal">
                    <div class="ms-product-media">
                        <img src="@item.ProductImageUrl" alt="@item.ProductName">

                        @if (indirim > 0)
                        {
                            <span class="ms-product-tag">%@indirim indirim</span>
                        }

                        <div class="ms-product-tools">
                            <a class="ms-tool" href="" title="Favorilere ekle"><i class="far fa-heart"></i></a>
                            <a class="ms-tool" href="" title="Karşılaştır"><i class="fa fa-sync-alt"></i></a>
                            <a class="ms-tool" href="" title="Hızlı bakış"><i class="fa fa-search"></i></a>
                        </div>
                        <a class="ms-product-cart" href="/ShoppingCart/AddBasketItem/@item.ProductId">
                            <i class="fa fa-shopping-cart"></i> Sepete Ekle
                        </a>
                    </div>
                    <div class="ms-product-body">
                        <a class="ms-product-name" href="/ProductList/ProductDetail/@item.ProductId">@item.ProductName</a>
                        <div class="ms-rating">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <span>(25)</span>
                        </div>
                        <div class="ms-price">
                            <span class="ms-price-now">@item.ProductPrice ₺</span>
                            <span class="ms-price-old">@x ₺</span>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
