@model List<ResultAboutDto>

<div class="ms-footer">
    <div class="container-fluid px-xl-5">
        <div class="row ms-footer-top">

            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-12 mb-5 pr-lg-5">
                    <a href="#" class="ms-logo">
                        <span class="ms-logo-word"><span class="ms-logo-a">Multi</span>Shop<span class="ms-logo-dot"></span></span>
                    </a>

                    <p class="ms-footer-about">@item.Description</p>

                    <ul class="ms-footer-contact">
                        <li><i class="fa fa-map-marker-alt"></i><span>@item.Address</span></li>
                        <li><i class="fa fa-envelope"></i><span>@item.Email</span></li>
                        <li><i class="fa fa-phone-alt"></i><span>@item.Phone</span></li>
                    </ul>
                </div>
            }

            <div class="col-lg-8 col-md-12">
                <div class="row">
                    <div class="col-md-4 mb-5">
                        <h5 class="ms-footer-title">Hızlı Alışveriş</h5>
                        <div class="ms-footer-links">
                            <a href="#"><i class="fa fa-angle-right"></i>Ana Sayfa</a>
                            <a href="#"><i class="fa fa-angle-right"></i>Ürünlerimiz</a>
                            <a href="#"><i class="fa fa-angle-right"></i>Günün Fırsatı</a>
                            <a href="#"><i class="fa fa-angle-right"></i>İndirimler</a>
                            <a href="#"><i class="fa fa-angle-right"></i>Sepetim</a>
                            <a href="#"><i class="fa fa-angle-right"></i>Bize Yazın</a>
                        </div>
                    </div>
                    <div class="col-md-4 mb-5">
                        <h5 class="ms-footer-title">Hesabım</h5>
                        <div class="ms-footer-links">
                            <a href="#"><i class="fa fa-angle-right"></i>Profilim</a>
                            <a href="#"><i class="fa fa-angle-right"></i>Alışverişlerim</a>
                            <a href="#"><i class="fa fa-angle-right"></i>Sepet Detaylarım</a>
                            <a href="#"><i class="fa fa-angle-right"></i>Geçmiş Ürünlerim</a>
                            <a href="#"><i class="fa fa-angle-right"></i>İndirimlerim</a>
                            <a href="#"><i class="fa fa-angle-right"></i>İletişim</a>
                        </div>
                    </div>
                    <div class="col-md-4 mb-5">
                        <h5 class="ms-footer-title">Mail Bülteni</h5>
                        <p class="mb-0">En son indirimler ve kampanyalar için hemen abone olun.</p>
                        <form action="">
                            <div class="ms-news">
                                <input type="text" placeholder="Email Adresiniz">
                                <button type="submit">Abone Ol</button>
                            </div>
                        </form>
                        <h5 class="ms-footer-title">Bizi Takip Edin</h5>
                        <div class="ms-social">
                            <a href="#" title="Twitter"><i class="fab fa-twitter"></i></a>
                            <a href="#" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ms-footer-bottom">
            <p>&copy; <a href="#">MultiShop</a>. Tüm hakları saklıdır.</p>
            <img src="~/online-shop-website-template/img/payments.png" alt="Ödeme yöntemleri">
        </div>
    </div>
</div>
