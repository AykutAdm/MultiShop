@model List<ResultSpecialOfferDto>

<div class="col-lg-4 ms-hero-side">

    @foreach (var item in Model)
    {
        <a href="" class="ms-promo">
            <img src="@item.ImageUrl" alt="@item.Title">
            <span class="ms-promo-veil"></span>
            <span class="ms-promo-body">
                <span class="ms-promo-kicker">@item.Title</span>
                <span class="ms-promo-title">@item.SubTitle</span>
                <span class="ms-promo-cta">Alışverişe Başlayın <i class="fa fa-arrow-right"></i></span>
            </span>
        </a>
    }

</div>
