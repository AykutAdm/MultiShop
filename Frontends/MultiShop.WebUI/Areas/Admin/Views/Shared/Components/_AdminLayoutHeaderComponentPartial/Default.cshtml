@{
    var greeting = DateTime.Now.Hour < 12 ? "Günaydın" : DateTime.Now.Hour < 18 ? "İyi günler" : "İyi akşamlar";
}

<nav class="navbar">

    <!-- Sidebar aç / daralt -->
    <button class="navbar-toggler" type="button" data-toggle="minimize" aria-label="Menüyü aç veya daralt">
        <span class="mdi mdi-menu"></span>
    </button>

    <!-- Başlık -->
    <div class="navbar-title d-none d-md-block">
        <h4>@greeting, Aykut Adem</h4>
        <span>@DateTime.Now.ToString("dd MMMM yyyy, dddd")</span>
    </div>

    <!-- Arama -->
    <form action="#" method="get" class="topbar-search d-none d-lg-block ms-3">
        <i class="mdi mdi-magnify"></i>
        <input type="text" name="search" class="form-control" placeholder="Aranacak kelimeyi giriniz..." aria-label="Ara">
    </form>

    <ul class="navbar-nav ms-auto">

        <!-- Mesajlar -->
        <li class="nav-item dropdown d-none d-sm-flex">
            <a class="topbar-icon-btn dropdown-toggle" href="#" id="adminMessageDropdown" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <i class="mdi mdi-email-outline"></i>
                <span class="count bg-info">@ViewBag.messageCount</span>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="adminMessageDropdown">
                <div class="dropdown-header">Mesajlar</div>
                <a class="dropdown-item" href="/Admin/Comment/Index/">
                    <span class="preview-icon bg-info"><i class="mdi mdi-account-outline"></i></span>
                    <span class="preview-item-content">
                        <span class="preview-subject">Yeni müşteri mesajı</span>
                        <span class="preview-text">2 dakika önce</span>
                    </span>
                </a>
                <a class="dropdown-item" href="/Admin/Comment/Index/">
                    <span class="preview-icon bg-success"><i class="mdi mdi-comment-text-outline"></i></span>
                    <span class="preview-item-content">
                        <span class="preview-subject">Ürün yorumu onay bekliyor</span>
                        <span class="preview-text">15 dakika önce</span>
                    </span>
                </a>
            </div>
        </li>

        <!-- Bildirimler -->
        <li class="nav-item dropdown">
            <a class="topbar-icon-btn dropdown-toggle" href="#" id="adminNotificationDropdown" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <i class="mdi mdi-bell-outline"></i>
                <span class="count bg-danger">@ViewBag.totalCommentCount</span>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="adminNotificationDropdown">
                <div class="dropdown-header">Bildirimler</div>
                <a class="dropdown-item" href="/Admin/Category/Index/">
                    <span class="preview-icon bg-warning"><i class="mdi mdi-alert-outline"></i></span>
                    <span class="preview-item-content">
                        <span class="preview-subject">Stok seviyesi düşük</span>
                        <span class="preview-text">3 üründe kritik stok</span>
                    </span>
                </a>
                <a class="dropdown-item" href="/Admin/Product/ProductListWithCategory/">
                    <span class="preview-icon bg-success"><i class="mdi mdi-check-circle-outline"></i></span>
                    <span class="preview-item-content">
                        <span class="preview-subject">Yeni ürün eklendi</span>
                        <span class="preview-text">Bugün, 09:24</span>
                    </span>
                </a>
            </div>
        </li>

        <!-- Yönetici profili -->
        <li class="nav-item nav-profile dropdown ms-1">
            <a class="topbar-profile dropdown-toggle" href="#" id="adminProfileDropdown" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <img src="~/images/logos/admin.png" alt="Admin" />
                <span class="nav-profile-name d-none d-sm-inline">Aykut Adem</span>
                <i class="mdi mdi-chevron-down"></i>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="adminProfileDropdown">
                <div class="dropdown-header">multishop@@gmail.com</div>
                <a class="dropdown-item" href="#">
                    <i class="mdi mdi-account-outline"></i> Profilim
                </a>
                <a class="dropdown-item" href="#">
                    <i class="mdi mdi-wallet-outline"></i> Bakiyem
                </a>
                <a class="dropdown-item" href="#">
                    <i class="mdi mdi-inbox-arrow-down-outline"></i> Gelen Kutusu
                </a>
                <a class="dropdown-item" href="/Admin/User/UserList/">
                    <i class="mdi mdi-account-group-outline"></i> Kullanıcı Listesi
                </a>
                <a class="dropdown-item" href="#">
                    <i class="mdi mdi-cog-outline"></i> Hesap Ayarları
                </a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="/Default/Index/">
                    <i class="mdi mdi-storefront-outline"></i> Siteye Git
                </a>
                <a class="dropdown-item" href="#">
                    <i class="mdi mdi-logout-variant"></i> Çıkış Yap
                </a>
            </div>
        </li>

    </ul>

</nav>
