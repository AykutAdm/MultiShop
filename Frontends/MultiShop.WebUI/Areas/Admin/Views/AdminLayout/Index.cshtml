@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")

<body class="nova-dark">

    <div class="wrapper container-scroller">

        <!-- Sol menü -->
        @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

        <div class="sidebar-backdrop"></div>

        <div class="page-body-wrapper">

            <!-- Üst bar -->
            @await Component.InvokeAsync("_AdminLayoutHeaderComponentPartial")

            <div class="main-panel">
                <div class="content-wrapper">

                    <!-- Sayfa başlığı (ViewBag) -->
                    @await Component.InvokeAsync("_AdminLayoutMainSectionViewbagComponentPartial")

                    <!-- Sayfa içeriği -->
                    @RenderBody()

                </div>
            </div>

            <footer class="main-footer">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <span>Copyright &copy; @DateTime.Now.Year MultiShop. Tüm hakları saklıdır.</span>
                    <span>Version 1.0</span>
                </div>
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/user-theme/js/dark-theme.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
