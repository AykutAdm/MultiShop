@{
    var navUserName = User?.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity.Name)
        ? User.Identity.Name
        : "Ali Yıldırım";

    var navInitials = string.Join("", navUserName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(x => char.ToUpperInvariant(x[0])));

    var greeting = DateTime.Now.Hour < 12 ? "Günaydın" : DateTime.Now.Hour < 18 ? "İyi günler" : "İyi akşamlar";
}

<nav class="navbar">

    <!-- Sidebar aç / daralt -->
    <button class="navbar-toggler" type="button" data-toggle="minimize" aria-label="Menüyü aç veya daralt">
        <span class="mdi mdi-menu"></span>
    </button>

    <!-- Başlık -->
    <div class="navbar-title d-none d-md-block">
        <h4>@greeting, @navUserName</h4>
        <span>@DateTime.Now.ToString("dd MMMM yyyy, dddd")</span>
    </div>

    <!-- Arama -->
    <div class="topbar-search d-none d-lg-block ms-3">
        <i class="mdi mdi-magnify"></i>
        <input type="text" class="form-control" placeholder="Sipariş, mesaj veya ürün ara..." aria-label="Ara">
    </div>

    <ul class="navbar-nav ms-auto">

        <!-- Takvim -->
        <li class="nav-item dropdown d-none d-sm-flex">
            <a class="topbar-icon-btn dropdown-toggle" href="#" id="calendarDropdown" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <i class="mdi mdi-calendar-blank-outline"></i>
                <span class="count bg-info">2</span>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="calendarDropdown">
                <div class="dropdown-header">Yaklaşan</div>
                <a class="dropdown-item" href="#">
                    <span class="preview-icon bg-info"><i class="mdi mdi-truck-outline"></i></span>
                    <span class="preview-item-content">
                        <span class="preview-subject">Kargo teslimatı</span>
                        <span class="preview-text">Yarın, 14:00 - 18:00</span>
                    </span>
                </a>
                <a class="dropdown-item" href="#">
                    <span class="preview-icon bg-warning"><i class="mdi mdi-tag-outline"></i></span>
                    <span class="preview-item-content">
                        <span class="preview-subject">Kampanya bitişi</span>
                        <span class="preview-text">3 gün sonra</span>
                    </span>
                </a>
            </div>
        </li>

        <!-- Mesajlar -->
        <li class="nav-item dropdown">
            <a class="topbar-icon-btn dropdown-toggle" href="#" id="messageDropdown" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <i class="mdi mdi-email-outline"></i>
                <span class="count bg-danger">1</span>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="messageDropdown">
                <div class="dropdown-header">Mesajlar</div>
                <a class="dropdown-item" href="/User/Message/Inbox">
                    <span class="preview-icon bg-success"><i class="mdi mdi-inbox-arrow-down"></i></span>
                    <span class="preview-item-content">
                        <span class="preview-subject">Gelen kutusu</span>
                        <span class="preview-text">Okunmamış mesajlarınız</span>
                    </span>
                </a>
                <a class="dropdown-item" href="/User/Message/Sendbox">
                    <span class="preview-icon bg-info"><i class="mdi mdi-send"></i></span>
                    <span class="preview-item-content">
                        <span class="preview-subject">Gönderilenler</span>
                        <span class="preview-text">Gönderdiğiniz mesajlar</span>
                    </span>
                </a>
            </div>
        </li>

        <!-- Profil -->
        <li class="nav-item nav-profile dropdown ms-1">
            <a class="topbar-profile dropdown-toggle" href="#" id="profileDropdown" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar-fallback">@navInitials</span>
                <span class="nav-profile-name d-none d-sm-inline">@navUserName</span>
                <i class="mdi mdi-chevron-down"></i>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                <div class="dropdown-header">Hesabım</div>
                <a class="dropdown-item" href="#">
                    <i class="mdi mdi-account-outline"></i> Profilim
                </a>
                <a class="dropdown-item" href="/User/MyOrder/MyOrderList">
                    <i class="mdi mdi-package-variant-closed"></i> Siparişlerim
                </a>
                <a class="dropdown-item" href="#">
                    <i class="mdi mdi-cog-outline"></i> Ayarlar
                </a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="#">
                    <i class="mdi mdi-logout-variant"></i> Çıkış Yap
                </a>
            </div>
        </li>

    </ul>

</nav>
