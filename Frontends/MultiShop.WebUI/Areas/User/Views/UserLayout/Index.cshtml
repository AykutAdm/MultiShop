@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_UserLayoutHeadComponentPartial")

<body class="nova-dark">

    <div class="container-scroller">

        @await Component.InvokeAsync("_UserLayoutSideBarComponentPartial")

        <div class="sidebar-backdrop"></div>

        <div class="page-body-wrapper">

            @await Component.InvokeAsync("_UserLayoutNavbarComponentPartial")

            @RenderBody()

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/user-theme/js/dark-theme.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
